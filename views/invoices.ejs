<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Invoices - Subscription Management System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Subscription Management System</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/plans">Plans</a></li>
          <li class="nav-item"><a class="nav-link" href="/customers">Customers</a></li>
          <li class="nav-item"><a class="nav-link" href="/subscriptions">Subscriptions</a></li>
          <li class="nav-item"><a class="nav-link active" href="/invoices">Invoices</a></li>
          <li class="nav-item"><a class="nav-link" href="/reports">Reports</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>Invoices</h2>
      <a href="/invoice/new" class="btn btn-primary">Add Invoice</a>
    </div>

    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Invoice ID</th>
          <th>Customer Name</th>
          <th>Plan Name</th>
          <th>Amount</th>
          <th>Date</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% invoices.forEach(function(invoice) { %>
          <tr>
            <td><%= invoice.id %></td>
            <td><%= invoice.customerName %></td>
            <td><%= invoice.planName %></td>
            <td>$<%= Number(invoice.amount).toFixed(2) %></td>
            <td><%= invoice.date %></td>
            <td>
              <% if(invoice.status === 'Paid') { %>
                <span class="badge bg-success">Paid</span>
              <% } else if(invoice.status === 'Unpaid') { %>
                <span class="badge bg-warning text-dark">Unpaid</span>
              <% } else { %>
                <span class="badge bg-secondary"><%= invoice.status %></span>
              <% } %>
            </td>
            <td>
              <form action="/invoice/delete/<%= invoice.id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
